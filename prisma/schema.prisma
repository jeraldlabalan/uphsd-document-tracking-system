generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  RoleID    Int     @id @default(autoincrement())
  RoleName  String
  IsDeleted Boolean @default(false)
  Users     User[]
}

model Department {
  DepartmentID Int        @id @default(autoincrement())
  Name         String
  IsDeleted    Boolean    @default(false)
  Documents    Document[]
  Users        User[]
}

model Position {
  PositionID Int     @id @default(autoincrement())
  IsDeleted  Boolean @default(false)
  Name       String
  Users      User[]
}

model User {
  UserID                                     Int               @id @default(autoincrement())
  FirstName                                  String
  LastName                                   String
  Email                                      String            @unique
  Password                                   String
  MobileNumber                               String
  Sex                                        String
  RoleID                                     Int
  DepartmentID                               Int?
  PositionID                                 Int
  EmployeeID                                 String            @unique
  ProfilePicture                             String?
  IsActive                                   Boolean           @default(true)
  IsDeleted                                  Boolean           @default(false)
  CreatedAt                                  DateTime          @default(now())
  UpdatedAt                                  DateTime          @updatedAt
  ActivityLogs                               ActivityLog[]
  Documents                                  Document[]        @relation("CreatedDocuments")
  DocumentRequests                           DocumentRequest[]
  DocumentVersions                           DocumentVersion[]
  ESignatures                                ESignature[]
  Notification_Notification_ReceiverIDToUser Notification[]    @relation("Notification_ReceiverIDToUser")
  Notification_Notification_SenderIDToUser   Notification[]    @relation("Notification_SenderIDToUser")
  Department                                 Department?       @relation(fields: [DepartmentID], references: [DepartmentID])
  Position                                   Position          @relation(fields: [PositionID], references: [PositionID])
  Role                                       Role              @relation(fields: [RoleID], references: [RoleID])
}

model Document {
  DocumentID   Int               @id @default(autoincrement())
  Title        String
  Description  String
  CreatedBy    Int
  DepartmentID Int?
  CreatedAt    DateTime          @default(now())
  UpdatedAt    DateTime          @updatedAt
  Status       String            @default("Active")
  IsDeleted    Boolean           @default(false)
  TypeID       Int
  Creator      User              @relation("CreatedDocuments", fields: [CreatedBy], references: [UserID])
  Department   Department?       @relation(fields: [DepartmentID], references: [DepartmentID])
  DocumentType DocumentType      @relation(fields: [TypeID], references: [TypeID])
  Requests     DocumentRequest[]
  Versions     DocumentVersion[]
}

model Status {
  StatusID         Int               @id @default(autoincrement())
  StatusName       String
  IsDeleted        Boolean           @default(false)
  DocumentRequests DocumentRequest[]
}

model DocumentRequest {
  RequestID   Int         @id @default(autoincrement())
  UserID      Int
  DocumentID  Int
  StatusID    Int
  RequestedAt DateTime    @default(now())
  CompletedAt DateTime?
  Priority    String      @default("Normal")
  Remarks     String?
  IsDeleted   Boolean     @default(false)
  Document    Document    @relation(fields: [DocumentID], references: [DocumentID])
  Status      Status      @relation(fields: [StatusID], references: [StatusID])
  User        User        @relation(fields: [UserID], references: [UserID])
  ESignature  ESignature?
}

model ActivityLog {
  LogID       Int      @id @default(autoincrement())
  PerformedBy Int
  Action      String
  TargetType  String
  TargetID    Int
  Remarks     String?
  Timestamp   DateTime @default(now())
  IsDeleted   Boolean  @default(false)
  User        User     @relation(fields: [PerformedBy], references: [UserID])
}

model ESignature {
  ESignatureID  Int             @id @default(autoincrement())
  RequestID     Int             @unique
  SignedBy      Int
  SignatureData String
  SignedAt      DateTime        @default(now())
  IsDeleted     Boolean         @default(false)
  Request       DocumentRequest @relation(fields: [RequestID], references: [RequestID])
  User          User            @relation(fields: [SignedBy], references: [UserID])
}

model DocumentVersion {
  VersionID         Int      @id @default(autoincrement())
  DocumentID        Int
  VersionNumber     Int
  ChangedBy         Int
  ChangeDescription String
  FilePath          String?
  CreatedAt         DateTime @default(now())
  IsDeleted         Boolean  @default(false)
  User              User     @relation(fields: [ChangedBy], references: [UserID])
  Document          Document @relation(fields: [DocumentID], references: [DocumentID])
}

model Notification {
  NotificationID                     Int       @id @default(autoincrement())
  Title                              String
  Message                            String
  IsRead                             Boolean   @default(false)
  CreatedAt                          DateTime  @default(now())
  ReadAt                             DateTime?
  IsDeleted                          Boolean   @default(false)
  ReceiverID                         Int
  SenderID                           Int
  User_Notification_ReceiverIDToUser User      @relation("Notification_ReceiverIDToUser", fields: [ReceiverID], references: [UserID])
  User_Notification_SenderIDToUser   User      @relation("Notification_SenderIDToUser", fields: [SenderID], references: [UserID])
}

model DocumentType {
  TypeID    Int        @id @default(autoincrement())
  TypeName  String
  IsDeleted Boolean    @default(false)
  Document  Document[]
}
